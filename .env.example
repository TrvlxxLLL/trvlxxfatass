# Скопируйте в .env рядом с docker-compose.yml и заполните.
# Файл .env в git не коммитим.

# Подпись сессий кабинета разработчика (обязательно, 32+ символа).
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ключ gptunnel. Можно не задавать здесь, а ввести в кабинете /dev.
GPTUNNEL_API_KEY=

# Ключ авторизации GigaChat (Authorization key из кабинета Sber Developers
# или пара client_id:client_secret). Можно ввести в кабинете /dev.
GIGACHAT_AUTH_KEY=

# Необязательно: путь к PEM-файлу с доверенными корневыми сертификатами
# (если включаете проверку TLS для GigaChat).
AI_CA_BUNDLE=

# Доступ в кабинет разработчика (заглушка на время хакатона).
# Аккаунт создаётся автоматически при запуске приложения.
DEV_LOGIN=dev
DEV_PASSWORD=suhovl2025

# Подложка карты: yandex (по умолчанию) или osm.
MAP_PROVIDER=yandex

# Геокодер адреса по координатам: nominatim (по умолчанию) или yandex.
# Для yandex нужен ключ геокодера Яндекса.
GEOCODER=nominatim
YANDEX_GEOCODER_KEY=

# 1 — если приложение работает за HTTPS-прокси (cookie только по HTTPS).
COOKIE_SECURE=0

# 1 — доверять заголовку X-Forwarded-For (только если спереди свой nginx).
TRUST_PROXY=0
